# Spotube Web server configuration.
#
# Local development:  copy to `.env.local` (used by `npm run dev` / `npm start`)
# Workers preview:    copy to `.dev.vars`  (used by `npm run cf:preview` / `wrangler dev`)
# Cloudflare deploy:  set secrets with `npx wrangler secret put NAME` (or in the dashboard),
#                     non-secret values can go under "vars" in wrangler.jsonc.
#
# Every provider is optional. Without any keys the site still works: local playlists,
# likes, history, import/export, and playing pasted YouTube / Spotify / SoundCloud links.

# --- YouTube Data API v3 (search, playlists, channels, trending) -------------------
# Google Cloud console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
# Restrict the key to the YouTube Data API. Default quota: 10,000 units/day (a search costs 100).
YOUTUBE_API_KEY=
# Region for the "Trending music" shelf on Home (ISO 3166-1 alpha-2).
YOUTUBE_REGION_CODE=US

# --- Spotify Web API (search/metadata, optional account connection) ----------------
# https://developer.spotify.com/dashboard → Create app → add Redirect URI:
#   https://YOUR-DOMAIN/api/spotify/callback      (production)
#   http://127.0.0.1:3000/api/spotify/callback    (local; Spotify does not accept "localhost")
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. Defaults to <request origin>/api/spotify/callback.
SPOTIFY_REDIRECT_URI=

# Required for connecting provider accounts. Encrypts the HttpOnly session cookie.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- SoundCloud API (search) ----------------------------------------------------------
# https://soundcloud.com/you/apps (new app registrations may be limited by SoundCloud).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# --- Apple Music (MusicKit JS) ----------------------------------------------------------
# Apple Developer account → Certificates, IDs & Profiles → Keys → create a MusicKit key.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Contents of the .p8 file. In a single-line env var, write newlines as \n.
APPLE_MUSIC_PRIVATE_KEY=

# Optional, comma separated. Restricts the MusicKit developer token to these origins,
# e.g. https://music.example.com
ALLOWED_ORIGINS=
